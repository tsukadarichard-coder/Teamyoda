rules_version = '2';

/* MTY · isolamento por academia.
   Cada conta de treinador carrega uma custom claim "orgId" (atribuída
   pelo administrador — nunca pelo próprio usuário). Um pedido só lê ou
   escreve dentro de orgs/{orgId}/** se o token de quem pediu tiver essa
   mesma orgId. Sem conta, sem claim, ou orgId diferente: acesso negado.

   Publicar: console do Firebase → Firestore Database → Regras → colar
   este arquivo → Publicar. */
service cloud.firestore {
  match /databases/{database}/documents {
    function orgDoToken() {
      return request.auth != null ? request.auth.token.orgId : null;
    }
    function papelDoToken() {
      return request.auth != null ? request.auth.token.role : null;
    }

    /* Feedback do aluno pro coordenador ("seu treinador não vê este
       campo") — por isso mora num documento À PARTE do resto dos dados
       da academia, com sua própria regra: só quem tem a custom claim
       role == "coordenador" lê ou escreve, mesmo sendo da mesma
       organização. A promessa feita ao aluno em aluno.html só é real se
       a barreira existir aqui, não só escondendo o campo na tela do
       treinador — um treinador pode logar e consultar o Firestore
       direto, então a regra de UI sozinha não bastava. A function
       ver-aluno.js usa o Admin SDK (ignora esta regra), então o aluno
       continua conseguindo enviar feedback pelo link sem precisar de
       conta nem desta claim.

       IMPORTANTE: regras do Firestore são permissivas por OR — se
       qualquer match que bata com o caminho tiver allow verdadeiro, o
       pedido passa, não importa quão mais restritiva seja outra regra.
       Por isso dados/{doc} abaixo não pode usar {document=**}/coringa
       geral: ele teria que excluir explicitamente este documento, e é
       mais simples (e mais difícil de furar por engano numa edição
       futura) enumerar as subcoleções reais de orgs/{orgId} em vez de
       um catch-all, e deixar o feedback como a única cujo id é citado
       por igualdade, nunca por reticência de wildcard. */
    match /orgs/{orgId}/dados/mty:feedbacks-coordenador:v1 {
      allow read, write: if orgDoToken() != null && orgDoToken() == orgId && papelDoToken() == "coordenador";
    }
    match /orgs/{orgId}/dados/{doc} {
      allow read, write: if orgDoToken() != null && orgDoToken() == orgId && doc != "mty:feedbacks-coordenador:v1";
    }
    match /orgs/{orgId}/iaJobs/{document=**} {
      allow read, write: if orgDoToken() != null && orgDoToken() == orgId;
    }
    /* Só LEITURA pro cliente — meta/info guarda plano/planoAtivoAte, que
       só pode ser alterado pelas functions administrativas (Admin SDK,
       que ignora estas regras: provisionar-org, atualizar-org, webhook-
       eduzz). Se o cliente pudesse escrever aqui, bastaria abrir o
       console do navegador e chamar
       db.collection("orgs").doc(orgId).collection("meta").doc("info")
         .set({ plano: "premium" })
       pra se autoconceder um plano pago sem pagar — o limite de alunos
       na interface não vale nada se o documento que ele lê pode ser
       escrito por quem ele mesmo limita. */
    match /orgs/{orgId}/meta/{document=**} {
      allow read: if orgDoToken() != null && orgDoToken() == orgId;
    }

    /* Pedido de acesso de um treinador novo — ele ainda não tem orgId
       (só ganha isso quando o coordenador aprova, via function), então a
       regra acima não bastaria. Só pode criar/ler o PRÓPRIO pedido,
       nunca ler o de outra pessoa nem a lista inteira. */
    match /orgs/{orgId}/solicitacoes/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
